<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:Carl Lom

Philips PM 3585 logic analyzer front panel, stylized after a photo of the unit.
Keys map to the panel keyboard matrix (kbd:LINE0-7). The dial is not clickable;
use the mouse or PgUp/PgDn.
-->
<mamelayout version="2">

	<!-- Cabinet -->

	<element name="frame"><rect><color red="0.55" green="0.55" blue="0.52"/></rect></element>
	<element name="panel"><rect><color red="0.84" green="0.83" blue="0.79"/></rect></element>
	<element name="strip"><rect><color red="0.90" green="0.89" blue="0.86"/></rect></element>
	<element name="bezel"><rect><color red="0.20" green="0.20" blue="0.20"/></rect></element>
	<element name="slot"><rect><color red="0.15" green="0.15" blue="0.15"/></rect></element>

	<element name="title"><text string="PM 3585  logic analyzer  200MHz" align="1"><color red="0.25" green="0.25" blue="0.25"/></text></element>
	<element name="brand"><text string="PHILIPS" align="2"><color red="0.15" green="0.15" blue="0.15"/></text></element>

	<element name="dial">
		<disk><bounds x="0" y="0" width="128" height="128"/><color red="0.40" green="0.40" blue="0.38"/></disk>
		<disk><bounds x="2" y="2" width="124" height="124"/><color red="0.95" green="0.95" blue="0.93"/></disk>
		<disk><bounds x="95" y="49" width="30" height="30"/><color red="0.75" green="0.75" blue="0.73"/></disk>
		<disk><bounds x="96" y="50" width="28" height="28"/><color red="0.92" green="0.92" blue="0.90"/></disk>
	</element>

	<!-- Key bodies, one per key style; state 1 = pressed -->

	<element name="key_func"> <!-- function keys -->
		<rect><bounds x="0" y="0" width="34" height="20"/><color red="0.25" green="0.25" blue="0.25"/></rect>
		<rect><bounds x="1" y="1" width="32" height="18"/><color state="0" red="0.66" green="0.66" blue="0.64"/><color state="1" red="0.46" green="0.46" blue="0.44"/></rect>
	</element>
	<element name="key_nav"> <!-- cursor keys -->
		<rect><bounds x="0" y="0" width="34" height="20"/><color red="0.25" green="0.25" blue="0.25"/></rect>
		<rect><bounds x="1" y="1" width="32" height="18"/><color state="0" red="0.36" green="0.36" blue="0.36"/><color state="1" red="0.20" green="0.20" blue="0.20"/></rect>
	</element>
	<element name="key_data"> <!-- keypad and alphanumeric keys -->
		<rect><bounds x="0" y="0" width="34" height="20"/><color red="0.25" green="0.25" blue="0.25"/></rect>
		<rect><bounds x="1" y="1" width="32" height="18"/><color state="0" red="0.96" green="0.96" blue="0.94"/><color state="1" red="0.72" green="0.72" blue="0.70"/></rect>
	</element>

	<!-- Key legends -->

	<element name="arrow_up"><image><data><![CDATA[<svg width="14" height="10" viewBox="0 0 14 10"><path fill="#eee" d="M 0,10 L 14,10 L 7,0 Z"/></svg>]]></data></image></element>
	<element name="arrow_down"><image><data><![CDATA[<svg width="14" height="10" viewBox="0 0 14 10"><path fill="#eee" d="M 0,0 L 14,0 L 7,10 Z"/></svg>]]></data></image></element>
	<element name="arrow_left"><image><data><![CDATA[<svg width="10" height="14" viewBox="0 0 10 14"><path fill="#eee" d="M 10,0 L 10,14 L 0,7 Z"/></svg>]]></data></image></element>
	<element name="arrow_right"><image><data><![CDATA[<svg width="10" height="14" viewBox="0 0 10 14"><path fill="#eee" d="M 0,0 L 0,14 L 10,7 Z"/></svg>]]></data></image></element>

