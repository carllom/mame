	<element name="transport_lbl0_text"><text string="COMPU"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl1_text"><text string="MANUAL"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl3_text"><text string="SONG SELECT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl4_text"><text string="STATUS"><color red="0.8" green="0.8" blue="0.8" /></text></element>
