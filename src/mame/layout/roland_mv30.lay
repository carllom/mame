	<element name="disk_text"><text string="DISK"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="mix_text"><text string="MIX"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="timbre_text"><text string="TIMBRE"><color red="0.8" green="0.8" blue="0.8" /></text></element>
