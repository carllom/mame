	<element name="system_text"><text string="SYSTEM"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="real_text"><text string="REAL"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="time_text"><text string="TIME"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="micro_text"><text string="MICRO"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="scope_text"><text string="SCOPE"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="track_text"><text string="TRACK" align="2"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="pattern_text"><text string="PATTERN" align="2"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="ins_text"><text string="INS"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="del_text"><text string="DEL"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="beat_text"><text string="BEAT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="value_text"><text string="VALUE"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="abc_text"><text string="ABC" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="def_text"><text string="DEF" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="ghi_text"><text string="GHI" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="jkl_text"><text string="JKL" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="mno_text"><text string="MNO" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="pqr_text"><text string="PQR" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="stu_text"><text string="STU" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="vwx_text"><text string="VWX" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="yz_text"><text string="YZ!" align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="spacedotc_text"><text string="SPACE.," align="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="space_text"><text string="SPACE"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="enter_text"><text string="ENTER"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<!-- interactive elements -->
	<element name="round_led" defstate="0">
		<disk state="0">
			<color red="0" green="0" blue="0" />
		</disk>
		<disk state="1">
			<color red="1" green="0.2" blue="0.2" />
		</disk>
		<disk state="2">
			<color red="0.2" green="1" blue="0.2" />
		</disk>
		<disk state="3">
			<color red="1" green="1" blue="0.2" />
		</disk>
	</element>

	<element name="rect_led" defstate="0">
		<rect state="0">
			<color red="0" green="0" blue="0" />
		</rect>
		<rect state="1">
			<color red="1" green="0.2" blue="0.2" />
		</rect>
		<rect state="2">
			<color red="0.2" green="1" blue="0.2" />
		</rect>
	</element>

	<element name="basic_button">
		<rect state="0"><color red="0.1" green="0.1" blue="0.1"/></rect>
		<rect state="1"><color red="0.3" green="0.3" blue="0.3"/></rect>
	</element>

	<element name="arrow_up_edge">
		<image>
			<data><![CDATA[<svg width="43" height="21.5" viewBox="0 0 43 21.5"><path fill="#000" d="M 0,21.5 L 43,21.5 L 21.5,0 Z" /></svg>]]></data>
		</image>
	</element>
	<element name="arrow_up">
		<image state="0">
			<data><![CDATA[<svg width="43" height="21.5" viewBox="0 0 43 21.5"><path fill="#1a1a1a" d="M 2.4,20.5 L 40.6,20.5 L 21.5,1 Z" /></svg>]]></data>
		</image>
		<image state="1">
			<data><![CDATA[<svg width="43" height="21.5" viewBox="0 0 43 21.5"><path fill="#4d4d4d" d="M 2.4,20.5 L 40.6,20.5 L 21.5,1 Z" /></svg>]]></data>
		</image>
	</element>

	<element name="arrow_down_edge">
		<image>
			<data><![CDATA[<svg width="43" height="21.5" viewBox="0 0 43 21.5"><path fill="#000" d="M 0,0 L 43,0 L 21.5,21.5 Z" /></svg>]]></data>
		</image>
	</element>
	<element name="arrow_down">
		<image state="0">
			<data><![CDATA[<svg width="43" height="21.5" viewBox="0 0 43 21.5"><path fill="#1a1a1a" d="M 2.4,1 L 40.6,1 L 21.5,20.5 Z" /></svg>]]></data>
		</image>
		<image state="1">
			<data><![CDATA[<svg width="43" height="21.5" viewBox="0 0 43 21.5"><path fill="#4d4d4d" d="M 2.4,1 L 40.6,1 L 21.5,20.5 Z" /></svg>]]></data>
		</image>
	</element>

	<element name="arrow_left_edge">
		<image>
			<data><![CDATA[<svg width="21.5" height="43" viewBox="0 0 21.5 43"><path fill="#000" d="M 21.5,0 L 21.5,43 L 0,21.5 Z" /></svg>]]></data>
		</image>
	</element>
	<element name="arrow_left">
		<image state="0">
			<data><![CDATA[<svg width="21.5" height="43" viewBox="0 0 21.5 43"><path fill="#1a1a1a" d="M 20.5,40.6 L 20.5,2.4 L 1,21.5 Z" /></svg>]]></data>
		</image>
		<image state="1">
			<data><![CDATA[<svg width="21.5" height="43" viewBox="0 0 21.5 43"><path fill="#4d4d4d" d="M 20.5,40.6 L 20.5,2.4 L 1,21.5 Z" /></svg>]]></data>
		</image>
	</element>

	<element name="arrow_right_edge">
		<image>
			<data><![CDATA[<svg width="21.5" height="43" viewBox="0 0 21.5 43"><path fill="#000" d="M 0,0 L 0,43 L 21.5,21.5 Z" /></svg>]]></data>
		</image>
	</element>
	<element name="arrow_right">
		<image state="0">
			<data><![CDATA[<svg width="21.5" height="43" viewBox="0 0 21.5 43"><path fill="#1a1a1a" d="M 1,2.4 L 1,40.6 L 20.5,21.5 Z" /></svg>]]></data>
		</image>
		<image state="1">
			<data><![CDATA[<svg width="21.5" height="43" viewBox="0 0 21.5 43"><path fill="#4d4d4d" d="M 1,2.4 L 1,40.6 L 20.5,21.5 Z" /></svg>]]></data>
		</image>
	</element>

	<element name="small_button">
		<rect><bounds x="0" y="0" width="14" height="14"/><color red="0" green="0" blue="0" /></rect>
		<rect>
			<bounds x="1" y="1" width="12" height="12" />
			<color state="0" red="0.1" green="0.1" blue="0.1"/>
			<color state="1" red="0.3" green="0.3" blue="0.3"/>
		</rect>
	</element>

	<element name="medium_button">
		<rect><bounds x="0" y="0" width="22" height="21"/><color red="0" green="0" blue="0" /></rect>
		<rect>
			<bounds x="1" y="1" width="20" height="19"/>
			<color state="0" red="0.1" green="0.1" blue="0.1"/>
			<color state="1" red="0.3" green="0.3" blue="0.3"/>
		</rect>
	</element>

	<element name="wide_button">
		<rect><bounds x="0" y="0" width="58" height="21"/><color red="0" green="0" blue="0" /></rect>
		<rect>
			<bounds x="1" y="1" width="56" height="19"/>
			<color state="0" red="0.1" green="0.1" blue="0.1"/>
			<color state="1" red="0.3" green="0.3" blue="0.3"/>
		</rect>
	</element>

	<!-- Style elements -->

	<element name="lcd_bezel"><rect x="0" y="0" width="412" height="102"><color red="0" green="0" blue="0" /></rect></element>
	<element name="panel_bg"><rect><color red="0.2" green="0.2" blue="0.25" /></rect></element>
	<element name="line"><rect><color red="0.8" green="0.8" blue="0.8" /></rect></element>
	<element name="button_edge"><rect><color red="0" green="0" blue="0" /></rect></element>

	<element name="fader">
		<rect><bounds x="0" y="0" width="16" height="74" /><color red="0.12" green="0.12" blue="0.14" /></rect>
		<rect><bounds x="0.75" y="6" width="9.5" height="67.25" /><color red="0.17" green="0.17" blue="0.22" /></rect>
		<rect><bounds x="5" y="3" width="6" height="68" /><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="fader-knob">
		<rect>
			<bounds x="0" y="0" width="15" height="14" />
			<color state="0" red="0.1" green="0.1" blue="0.1"/>
			<color state="1" red="0.3" green="0.3" blue="0.3"/>
		</rect>
		<rect><bounds x="0" y="0" width="15" height="1.25" /><color red="0.33" green="0.33" blue="0.33" /></rect>
		<rect><bounds x="0" y="12.75" width="15" height="1.25" /><color red="0" green="0" blue="0" /></rect>
		<rect><bounds x="0" y="5.25" width="15" height="1" /><color red="0.33" green="0.33" blue="0.33" /></rect>
		<rect><bounds x="0" y="8.25" width="15" height="1" /><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="jogwheel_dimple">
		<disk><bounds x="-0.7" y="0.7" width="26" height="26"/><color red="0.33" green="0.33" blue="0.33" /></disk>
		<disk><bounds x="0" y="0" width="26" height="26"/><color red="0" green="0" blue="0" /></disk>
		<disk><bounds x="0" y="3" width="23" height="23"/><color red="0.1" green="0.1" blue="0.1" /></disk>
	</element>

	<element name="jogwheel">
		<disk><bounds x="0" y="0" width="84" height="84"/><color red="0" green="0" blue="0" /></disk>
		<disk><bounds x="1" y="1" width="82" height="82"/><color red="0.1" green="0.1" blue="0.1" /></disk>
	</element>

	<!-- Composite elements -->
	
	<group name="faderlines">
		<repeat count="3">
			<param name="yposm" start="0" increment="27.5"/>
			<element ref="line"><bounds x="0" y="~yposm~" width="1" height="1.5" /></element>
		</repeat>
		<repeat count="4">
			<param name="yposu" start="5.5" increment="5.5"/>
			<param name="yposl" start="33" increment="5.5"/>
			<element ref="line"><bounds x="0" y="~yposu~" width="1" height="1" /></element>
			<element ref="line"><bounds x="0" y="~yposl~" width="1" height="1" /></element>
		</repeat>
	</group>

	<!-- View sections -->

	<group name="display">
		<bounds x="0" y="0" width="412" height="154" />
		<element ref="lcd_bezel"><bounds x="0" y="0" width="412" height="102" /></element>
		<screen index="0"><bounds x="86" y="19" width="240" height="64" /></screen>
		
		<!-- shift button -->
		<element ref="button_edge"><bounds x="30" y="128" width="57" height="21"/></element>
		<element ref="basic_button" inputtag="SC0" inputmask="0x80"><bounds x="31" y="129" width="55" height="19"/></element>
		<element ref="shift_text"><bounds x="31" y="134" width="55" height="9" /></element>
		<!-- F1 button -->
		<element ref="button_edge"><bounds x="93" y="128" width="226" height="21"/></element>
		<element ref="basic_button" inputtag="SC1" inputmask="0x80"><bounds x="94" y="129" width="44" height="19"/></element>
		<element ref="f1_text"><bounds x="94" y="134" width="44" height="9" /></element>
		<!-- F2 button -->
		<element ref="basic_button" inputtag="SC2" inputmask="0x80"><bounds x="139" y="129" width="44" height="19"/></element>
		<element ref="f2_text"><bounds x="139" y="134" width="44" height="9" /></element>
		<!-- F3 button -->
		<element ref="basic_button" inputtag="SC3" inputmask="0x80"><bounds x="184" y="129" width="44" height="19"/></element>
		<element ref="f3_text"><bounds x="184" y="134" width="44" height="9" /></element>
		<!-- F4 button -->
		<element ref="basic_button" inputtag="SC4" inputmask="0x80"><bounds x="229" y="129" width="44" height="19"/></element>
		<element ref="f4_text"><bounds x="229" y="134" width="44" height="9" /></element>
		<!-- F5 button -->
		<element ref="basic_button" inputtag="SC5" inputmask="0x80"><bounds x="274" y="129" width="44" height="19"/></element>
		<element ref="f5_text"><bounds x="274" y="134" width="44" height="9" /></element>
		<!-- shift button -->
		<element ref="button_edge"><bounds x="325" y="128" width="57" height="21"/></element>
		<element ref="basic_button" inputtag="SC6" inputmask="0x80"><bounds x="326" y="129" width="55" height="19"/></element>
		<element ref="exit_text"><bounds x="326" y="134" width="55" height="9" /></element>
	</group>

	<group name="compumixer">
		<bounds x="0" y="0" width="396" height="140" />
		
		<!-- Header -->
		<element ref="line"><bounds x="79" y="7" width="125" height="1" /></element>
		<element ref="line"><bounds x="248" y="7" width="125" height="1" /></element>
		<element ref="compumixer_text"><bounds x="204" y="2.5" width="44" height="7" /></element>

		<!-- Channel buttons -->
		<repeat count="8">
			<param name="btn_x" start="80" increment="40"/>
			<param name="led_x" start="84.5" increment="40"/>
			<param name="chlo" start="1" increment="1"/>
			<param name="chhi" start="9" increment="1"/>
			<param name="count" start="0" increment="1"/>

			<element ref="~chlo~_~chhi~_text"><bounds x="~btn_x~" y="8.5" width="14" height="7" /></element>
			<element name="LED0~count~" ref="round_led"><bounds x="~led_x~" y="15" width="5" height="5" /></element>
			<element ref="small_button" inputtag="SC~count~" inputmask="0x40"><bounds x="~btn_x~" y="23" width="14" height="14" /></element>
		</repeat>		

		<!-- Channel fader lines and markers -->
		<group ref="faderlines"><bounds x="69" y="70" width="314" height="56" /></group>
		<element ref="max_text"><bounds x="55" y="67.5" width="15" height="7" /></element>
		<element ref="right_text"><bounds x="55" y="72.5" width="15" height="7" /></element>
		<element ref="min_text"><bounds x="55" y="121.5" width="15" height="7" /></element>
