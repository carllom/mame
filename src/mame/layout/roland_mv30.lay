copyright-holders:Carl Lom
-->
<mamelayout version="2">

<!-- define elements -->

	<element name="red_led" defstate="0">
		<disk state="1">
			<color red="1" green="0.2" blue="0.2" />
		</disk>
		<disk state="0">
			<color red="0.3" green="0.1" blue="0.1" />
		</disk>
	</element>

	<element name="red_led_highlight" defstate="0">
		<disk state="1">
			<color red="1" green=".7" blue=".7" />
		</disk>
		<disk state="0">
			<color red="0.5" green="0.2" blue="0.2" />
		</disk>
	</element>

	<element name="red_green_led" defstate="0">
		<rect state="1">
			<color red="1" green="0.2" blue="0.2" />
		</rect>
		<rect state="2">
			<color red="0.2" green="1" blue="0.2" />
		</rect>
		<rect state="0">
			<color red="0.2" green="0.2" blue="0.2" />
		</rect>
	</element>



	<element name="button">
		<rect state="0"><color red="0.25" green="0.25" blue="0.25"/></rect>
		<rect state="1"><color red="0.5" green="0.5" blue="0.5"/></rect>
	</element>

	<element name="tone_display_text"><text string="TONE DISPLAY"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="grey_arrows">
		<image><data><![CDATA[
			<svg width="90" height="110" viewBox="0 0 23.8125 29.1">
				<path fill="#d1d1d1" d="m 13.23,25.43 -1.32,3.67 -1.32,-3.67 z m 0,-21.76 L 11.9,0 10.58,3.67 Z m 6.88,9.94 3.7,1.3 -3.7,1.3 z m -16.4,0 L 0,14.92 3.7,16.23 Z" />
			</svg>
		]]></data></image>
	</element>

	<element name="shift_text"><text string="SHIFT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="f1_text"><text string="F1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="f2_text"><text string="F2"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="f3_text"><text string="F3"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="f4_text"><text string="F4"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="f5_text"><text string="F5"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="exit_text"><text string="EXIT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="compumixer_text"><text string="COMPU MIXER"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="1_9_text"><text string="1/9"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="2_10_text"><text string="2/10"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="3_11_text"><text string="3/11"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="4_12_text"><text string="4/12"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="5_13_text"><text string="5/13"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="6_14_text"><text string="6/14"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="7_15_text"><text string="7/15"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="8_16_text"><text string="8/16"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="max_text"><text string="MAX"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="min_text"><text string="MIN"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="left_text"><text string="(L)"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="right_text"><text string="(R)"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="0_text"><text string="0"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="10_text"><text string="10"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="mix_mode_text"><text string="MIX MODE"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="sequencer_text"><text string="SEQUENCER"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="ctrl_text"><text string="CTRL"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl0_text"><text string="COMPU"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl1_text"><text string="MANUAL"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl3_text"><text string="SONG SELECT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl4_text"><text string="STATUS"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl5_text"><text string="LOCATE"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl6_text"><text string="MARK"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_lbl7_text"><text string="TEMPO"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="rec_text"><text string="REC"><color red="0.8" green="0.2" blue="0.2" /></text></element>
	<element name="meas_dec_text"><text string="MEAS DEC"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="meas_inc_text"><text string="MEAS INC"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="start_stop_text"><text string="START/STOP"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_shift_l_text"><text string="|&lt;&lt; (SHIFT)"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="transport_shift_r_text"><text string="(SHIFT) &gt;&gt;|"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	

	<element name="lcd_bezel"><rect x="0" y="0" width="412" height="102"><color red="0" green="0" blue="0" /></rect></element>

	<element name="button_base">
		<rect state="0"><color red="0.1" green="0.1" blue="0.1"/></rect>
		<rect state="1"><color red="0.2" green="0.3" blue="0.3"/></rect>
	</element>

	<!-- large button, wide style -->
	<element name="wide_button">
		<rect state="0"><color red="0.1" green="0.1" blue="0.1"/></rect>
		<rect state="1"><color red="0.3" green="0.3" blue="0.3"/></rect>
	</element>

	<!-- large button, standard style -->
	<element name="func_button">
		<rect state="0"><color red="0.1" green="0.1" blue="0.1"/></rect>
		<rect state="1"><color red="0.3" green="0.3" blue="0.3"/></rect>
	</element>

	<!-- smallest square button -->
	<element name="track_button">
		<rect state="0"><color red="0.1" green="0.1" blue="0.1"/></rect>
		<rect state="1"><color red="0.3" green="0.3" blue="0.3"/></rect>
	</element>

	<element name="panel_bg"><rect><color red="0.2" green="0.2" blue="0.25" /></rect></element>
	<element name="button_edge"><rect><color red="0" green="0" blue="0" /></rect></element>
	<element name="line"><rect><color red="0.8" green="0.8" blue="0.8" /></rect></element>
	<element name="button_highlight"><rect><color red="0.33" green="0.33" blue="0.33" /></rect></element>
	<element name="button_shadow"><rect><color red="0" green="0" blue="0" /></rect></element>

	<element name="fader_bg_shadow"><rect><color red="0.12" green="0.12" blue="0.14" /></rect></element>
	<element name="fader_bg"><rect><color red="0.17" green="0.17" blue="0.22" /></rect></element>
	<element name="fader_track"><rect><color red="0" green="0" blue="0" /></rect></element>
	<element name="fader_knob_base"><rect><color red="0.1" green="0.1" blue="0.1" /></rect></element>
	<element name="fader_knob_line"><rect><color red="0.1" green="0.1" blue="0.1" /></rect></element>

	<group name="fader">
		<element ref="fader_bg_shadow"><bounds x="0" y="0" width="16" height="74" /></element>
		<element ref="fader_bg"><bounds x="0.75" y="6" width="9.5" height="67.25" /></element>
		<element ref="fader_track"><bounds x="5" y="3" width="6" height="68" /></element>
	</group>
	
	<group name="fader-knob">
		<element ref="button_base"><bounds x="0" y="0" width="15" height="14" /></element>
		<element ref="button_highlight"><bounds x="0" y="0" width="15" height="1.25" /></element>
		<element ref="button_shadow"><bounds x="0" y="12.75" width="15" height="1.25" /></element>
		<element ref="button_highlight"><bounds x="0" y="5.25" width="15" height="1" /></element>
		<element ref="button_shadow"><bounds x="0" y="8.25" width="15" height="1" /></element>
	</group>

	<group name="faderlines">
		<repeat count="3">
			<param name="yposm" start="0" increment="27.5"/>
			<element ref="line"><bounds x="0" y="~yposm~" width="1" height="1.5" /></element>
		</repeat>
		<repeat count="4">
			<param name="yposu" start="5.5" increment="5.5"/>
			<param name="yposl" start="33" increment="5.5"/>
			<element ref="line"><bounds x="0" y="~yposu~" width="1" height="1" /></element>
			<element ref="line"><bounds x="0" y="~yposl~" width="1" height="1" /></element>
		</repeat>
	</group>

	<!-- LCD section -->
	<group name="display">
		<!-- <bounds x="0" y="0" width="412" height="102" /> -->
		<bounds x="0" y="0" width="412" height="154" />
		<element ref="lcd_bezel"><bounds x="0" y="0" width="412" height="102" /></element>
		<screen index="0"><bounds x="86" y="19" width="240" height="64" /></screen>
		
		<!-- shift button -->
		<element ref="button_edge"><bounds x="30" y="128" width="57" height="21"/></element>
		<element ref="wide_button" inputtag="SC0" inputmask="0x80"><bounds x="31" y="129" width="55" height="19"/></element>
		<element ref="shift_text"><bounds x="31" y="134" width="55" height="9" /></element>
		<!-- F1 button -->
		<element ref="button_edge"><bounds x="93" y="128" width="226" height="21"/></element>
		<element ref="func_button" inputtag="SC1" inputmask="0x80"><bounds x="94" y="129" width="44" height="19"/></element>
		<element ref="f1_text"><bounds x="94" y="134" width="44" height="9" /></element>
		<!-- F2 button -->
		<element ref="func_button" inputtag="SC2" inputmask="0x80"><bounds x="139" y="129" width="44" height="19"/></element>
		<element ref="f2_text"><bounds x="139" y="134" width="44" height="9" /></element>
		<!-- F3 button -->
		<element ref="func_button" inputtag="SC3" inputmask="0x80"><bounds x="184" y="129" width="44" height="19"/></element>
		<element ref="f3_text"><bounds x="184" y="134" width="44" height="9" /></element>
		<!-- F4 button -->
		<element ref="func_button" inputtag="SC4" inputmask="0x80"><bounds x="229" y="129" width="44" height="19"/></element>
		<element ref="f4_text"><bounds x="229" y="134" width="44" height="9" /></element>
		<!-- F5 button -->
		<element ref="func_button" inputtag="SC5" inputmask="0x80"><bounds x="274" y="129" width="44" height="19"/></element>
		<element ref="f5_text"><bounds x="274" y="134" width="44" height="9" /></element>
		<!-- shift button -->
		<element ref="button_edge"><bounds x="325" y="128" width="57" height="21"/></element>
		<element ref="wide_button" inputtag="SC6" inputmask="0x80"><bounds x="326" y="129" width="55" height="19"/></element>
		<element ref="exit_text"><bounds x="326" y="134" width="55" height="9" /></element>
	</group>

	<!-- Compumixer section -->
	<group name="compumixer">
		<bounds x="0" y="0" width="396" height="140" />
		<element ref="panel_bg"><bounds x="0" y="0" width="396" height="140" /></element>
		
		<!-- Header -->
		<element ref="line"><bounds x="79" y="7" width="125" height="1" /></element>
		<element ref="line"><bounds x="248" y="7" width="125" height="1" /></element>
		<element ref="compumixer_text"><bounds x="204" y="4" width="44" height="4.5" /></element>

		<!-- Channel buttons -->
		<repeat count="8">
			<param name="edge_x" start="80" increment="40"/>
			<param name="led_x" start="84.5" increment="40"/>
			<param name="btn_x" start="81" increment="40"/>
			<param name="chlo" start="1" increment="1"/>
			<param name="chhi" start="9" increment="1"/>
			<param name="count" start="0" increment="1"/>

			<element ref="~chlo~_~chhi~_text"><bounds x="~edge_x~" y="9" width="14" height="4.5" /></element>
			<element name="LED0~count~" ref="red_led"><bounds x="~led_x~" y="15" width="5" height="5" /></element>
			<element ref="button_edge"><bounds x="~edge_x~" y="23" width="14" height="14"/></element>
			<element ref="button_base" inputtag="SC~count~" inputmask="0x40"><bounds x="~btn_x~" y="24" width="12" height="12" /></element>
		</repeat>		

		<!-- Channel fader lines and markers -->
		<group ref="faderlines"><bounds x="69" y="70" width="314" height="56" /></group>
		<element ref="max_text"><bounds x="55" y="68.5" width="15" height="5" /></element>
		<element ref="right_text"><bounds x="55" y="73.5" width="15" height="5" /></element>
		<element ref="min_text"><bounds x="55" y="123.5" width="15" height="5" /></element>
		<element ref="left_text"><bounds x="55" y="117.5" width="15" height="5" /></element>
		<element ref="max_text"><bounds x="382" y="68.5" width="15" height="5" /></element>
		<element ref="right_text"><bounds x="382" y="73.5" width="15" height="5" /></element>
		<element ref="min_text"><bounds x="382" y="123.5" width="15" height="5" /></element>
		<element ref="left_text"><bounds x="382" y="117.5" width="15" height="5" /></element>

		<!-- Master fader lines and markers -->
		<group ref="faderlines"><bounds x="9" y="70" width="33" height="56" /></group>
		<element ref="10_text"><bounds x="0" y="68.5" width="9" height="5" /></element>
		<element ref="0_text"><bounds x="0" y="123.5" width="9" height="5" /></element>
		<element ref="10_text"><bounds x="42" y="68.5" width="9" height="5" /></element>
		<element ref="0_text"><bounds x="42" y="123.5" width="9" height="5" /></element>

		<!-- Channel faders -->
		<repeat count="8">
			<param name="xpos" start="79" increment="40"/>
			<param name="count" start="0" increment="1"/>
			<group ref="fader"><bounds x="~xpos~" y="60.5" width="16" height="74" /></group>
			<group ref="fader-knob" id="SLIDER-KNOB~count~">
				<!-- <animate inputtag="SL~count~" inputmask="0xff"/> -->
				<bounds state="0"  x="~xpos~" y="118" width="15" height="14"/>
				<!-- <bounds state="100" x="~xpos~" y="63.5" width="15" height="14"/> -->
			</group>
		</repeat>

		<!-- Master fader (analog volume control, just for show) -->
		<group ref="fader"><bounds x="17.5" y="60.5" width="16" height="74" /></group>
		<group ref="fader-knob" id="SLIDER-KNOB9"><bounds state="100" x="17.5" y="63.5" width="15" height="14"/></group>

	</group>

	<group name="transport">
		<bounds x="0" y="0" width="366" height="88" />

		<!-- Mix mode header -->
		<element ref="line"><bounds x="66" y="8" width="14" height="1" /></element>
		<element ref="line"><bounds x="108" y="8" width="16" height="1" /></element>
		<element ref="mix_mode_text"><bounds x="74" y="5" width="40" height="4.5" /></element>

		<!-- ctrl button -->
		<element ref="button_edge"><bounds x="4.5" y="20.5" width="22" height="21"/></element>
		<element ref="wide_button" inputtag="SC0" inputmask="0x80"><bounds x="5.5" y="21.5" width="20" height="19"/></element>
		<element ref="ctrl_text"><bounds x="4.5" y="28.75" width="22" height="4.5" /></element>

		<!-- Sequencer header -->
		<element ref="line"><bounds x="178" y="8" width="80" height="1" /></element>
		<element ref="line"><bounds x="290" y="8" width="74" height="1" /></element>
		<element ref="sequencer_text"><bounds x="254" y="5" width="40" height="4.5" /></element>

		<element ref="transport_lbl0_text"><bounds x="54" y="10" width="40" height="4.5" /></element>
		<element name="LED10" ref="red_led"><bounds x="71.5" y="16" width="5" height="5" /></element>
		<element ref="button_edge"><bounds x="67" y="24" width="14" height="14"/></element>
		<element ref="button_base" inputtag="SC1" inputmask="0x10"><bounds x="68" y="25" width="12" height="12" /></element>

		<element ref="transport_lbl1_text"><bounds x="94" y="10" width="40" height="4.5" /></element>
		<element name="LED11" ref="red_led"><bounds x="111.5" y="16" width="5" height="5" /></element>
		<element ref="button_edge"><bounds x="107" y="24" width="14" height="14"/></element>
		<element ref="button_base" inputtag="SC2" inputmask="0x10"><bounds x="108" y="25" width="12" height="12" /></element>

		<repeat count="5">
			<param name="text_x" start="174" increment="40"/>
			<param name="edge_x" start="187" increment="40"/>
			<param name="led_x" start="191.5" increment="40"/>
			<param name="led_x_hi" start="194" increment="40"/>
			<param name="btn_x" start="188" increment="40"/>
			<param name="count" start="3" increment="1"/>
			<element ref="transport_lbl~count~_text"><bounds x="~text_x~" y="10" width="40" height="4.5" /></element>
			<element name="LED1~count~" ref="red_led"><bounds x="~led_x~" y="16" width="5" height="5" /></element>
			<element ref="red_led_highlight"><bounds x="~led_x_hi~" y="16.5" width="1.5" height="1.5" /></element>
			<element ref="button_edge"><bounds x="~edge_x~" y="24" width="14" height="14"/></element>
			<element ref="button_base" inputtag="SC~count~" inputmask="0x40"><bounds x="~btn_x~" y="25" width="12" height="12" /></element>
		</repeat>		

		<!-- rec button -->
		<element name="LED18" ref="red_led"><bounds x="191.5" y="49" width="5" height="5" /></element>
		<element ref="button_edge"><bounds x="183" y="57" width="22" height="21"/></element>
		<element ref="wide_button" inputtag="SC0" inputmask="0x80"><bounds x="184" y="58" width="20" height="19"/></element>
		<element ref="rec_text"><bounds x="183" y="64.5" width="22" height="6" /></element>

		<!-- rewind -->
		<element ref="meas_dec_text"><bounds x="226.75" y="43" width="40" height="4.5" /></element>
		<element ref="button_edge"><bounds x="227" y="57" width="39.5" height="21"/></element>
		<element ref="wide_button" inputtag="SC6" inputmask="0x80"><bounds x="228" y="58" width="37.5" height="19"/></element>
		<element ref="transport_shift_l_text"><bounds x="226.75" y="79" width="40" height="4.5" /></element>
		
		<!-- start/stop -->
		<element ref="start_stop_text"><bounds x="274" y="43" width="40" height="4.5" /></element>
		<element name="LED19" ref="red_led"><bounds x="291.5" y="49" width="5" height="5" /></element>
		<element ref="button_edge"><bounds x="265.5" y="57" width="57" height="21"/></element>
		<element ref="wide_button" inputtag="SC6" inputmask="0x80"><bounds x="266.5" y="58" width="55" height="19"/></element>

		<!-- fast forward -->
		<element ref="meas_inc_text"><bounds x="321.25" y="43" width="40" height="4.5" /></element>
		<element ref="button_edge"><bounds x="321.5" y="57" width="39.5" height="21"/></element>
		<element ref="wide_button" inputtag="SC6" inputmask="0x80"><bounds x="322.5" y="58" width="37.5" height="19"/></element>
		<element ref="transport_shift_r_text"><bounds x="321.25" y="79" width="40" height="4.5" /></element>

	</group>
<!-- build screen -->

	<view name="Display Only">
		<screen index="0">
			<bounds x="0" y="0" width="240" height="64" />
		</screen>
	</view>

	<view name="Full View">
		<bounds x="0" y="0" width="412" height="396" />
		<element ref="panel_bg"><bounds x="0" y="0" width="412" height="396"/></element>
		<group ref="display">
			<bounds x="0" y="0" width="412" height="154" />
		</group>
		<group ref="compumixer">
			<bounds x="10" y="154" width="396" height="140" />
		</group>
		<group ref="transport">
			<bounds x="23" y="308" width="366" height="88" />
		</group>
	</view>
</mamelayout>
